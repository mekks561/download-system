                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "timestamp": { "type": "string" },
                    "uptime": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": ["username", "email", "password"],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 20,
            "description": "用户名"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "邮箱地址"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "description": "密码"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["password"],
        "properties": {
          "username": {
            "type": "string",
            "description": "用户名（与email二选一）"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "邮箱地址（与username二选一）"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "description": "密码"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "data": {
            "type": "object",
            "properties": {
              "token": { "type": "string" },
              "user": { "$ref": "#/components/schemas/User" }
            }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "username": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string", "nullable": true },
          "two_factor_enabled": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "username": { "type": "string", "description": "用户名" },
          "email": { "type": "string", "format": "email", "description": "邮箱地址" },
          "phone": { "type": "string", "description": "手机号码" }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": ["oldPassword", "newPassword"],
        "properties": {
          "oldPassword": { "type": "string", "description": "旧密码" },
          "newPassword": { "type": "string", "minLength": 6, "description": "新密码" }
        }
      },
      "DownloadRequest": {
        "type": "object",
        "required": ["url", "filename"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "下载URL"
          },
          "filename": {
            "type": "string",
            "description": "文件名"
          }
        }
      },
      "DownloadUpdateRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["pending", "downloading", "completed", "error", "cancelled"],
            "description": "下载状态"
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "下载进度"
          },
          "downloaded_bytes": {
            "type": "integer",
            "description": "已下载字节数"
          },
          "total_bytes": {
            "type": "integer",
            "description": "总字节数"
          },
          "speed": {
            "type": "integer",
            "description": "下载速度（字节/秒）"
          },
          "resume_position": {
            "type": "integer",
            "description": "断点续传位置"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "description": "完成时间"
          }
        }
      },
      "Download": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "user_id": { "type": "integer" },
          "url": { "type": "string" },
          "filename": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "downloading", "completed", "error", "cancelled"]
          },
          "progress": { "type": "number" },
          "downloaded_bytes": { "type": "integer" },
          "total_bytes": { "type": "integer" },
          "speed": { "type": "integer" },
          "resume_position": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" },
          "completed_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "Upload": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "user_id": { "type": "integer" },
          "filename": { "type": "string" },
          "original_filename": { "type": "string" },
          "file_path": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "uploading", "completed", "error", "cancelled"]
          },
          "progress": { "type": "number" },
          "uploaded_bytes": { "type": "integer" },
          "total_bytes": { "type": "integer" },
          "speed": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" },
          "completed_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "error": { "type": "string", "nullable": true },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT认证令牌"
      }
    }
  }
}