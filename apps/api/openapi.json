{
  "openapi": "3.0.0",
  "info": {
    "title": "Download Manager API",
    "version": "3.0.0"
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ],
            "default": "user"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "createdAt",
          "updatedAt"
        ]
      },
      "Download": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "userId": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "downloading",
              "paused",
              "completed",
              "error",
              "cancelled"
            ]
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "downloadedBytes": {
            "type": "integer",
            "minimum": 0
          },
          "totalBytes": {
            "type": "integer",
            "minimum": 0
          },
          "speed": {
            "type": "integer",
            "minimum": 0
          },
          "resumePosition": {
            "type": "integer",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "userId",
          "url",
          "filename",
          "status",
          "progress",
          "downloadedBytes",
          "totalBytes",
          "speed",
          "resumePosition",
          "createdAt",
          "completedAt"
        ]
      },
      "Upload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "userId": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "originalFilename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "filePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "uploading",
              "completed",
              "error",
              "cancelled"
            ]
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "uploadedBytes": {
            "type": "integer",
            "minimum": 0
          },
          "totalBytes": {
            "type": "integer",
            "minimum": 0
          },
          "speed": {
            "type": "integer",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "userId",
          "filename",
          "originalFilename",
          "filePath",
          "status",
          "progress",
          "uploadedBytes",
          "totalBytes",
          "speed",
          "createdAt",
          "completedAt"
        ]
      },
      "File": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "userId": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "isDirectory": {
            "type": "boolean"
          },
          "parentId": {
            "type": "integer",
            "nullable": true,
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "userId",
          "name",
          "path",
          "type",
          "size",
          "isDirectory",
          "parentId",
          "createdAt",
          "updatedAt"
        ]
      },
      "Share": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "userId": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "fileId": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "token": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "expiresAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "downloadLimit": {
            "type": "integer",
            "nullable": true,
            "minimum": 0
          },
          "downloadCount": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "disabled",
              "expired"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "userId",
          "fileId",
          "token",
          "password",
          "expiresAt",
          "downloadLimit",
          "downloadCount",
          "status",
          "createdAt"
        ]
      },
      "Schedule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "userId": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "cron": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "type": {
            "type": "string",
            "enum": [
              "once",
              "daily",
              "weekly",
              "monthly"
            ]
          },
          "isEnabled": {
            "type": "boolean"
          },
          "lastRunAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "nextRunAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "userId",
          "url",
          "cron",
          "type",
          "isEnabled",
          "lastRunAt",
          "nextRunAt",
          "createdAt"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 50
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 128
                  }
                },
                "required": [
                  "username",
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "注册成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功"
          }
        }
      }
    },
    "/api/downloads": {
      "get": {
        "responses": {
          "200": {
            "description": "下载列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Download"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "maxLength": 2048,
                    "format": "uri"
                  },
                  "filename": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  }
                },
                "required": [
                  "url"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Download"
                }
              }
            }
          }
        }
      }
    },
    "/api/uploads": {
      "get": {
        "responses": {
          "200": {
            "description": "上传列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Upload"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/files": {
      "get": {
        "responses": {
          "200": {
            "description": "文件列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/File"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/shares": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fileId": {
                    "type": "integer",
                    "minimum": 0,
                    "exclusiveMinimum": true
                  },
                  "password": {
                    "type": "string",
                    "minLength": 4,
                    "maxLength": 128
                  },
                  "expiresAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "downloadLimit": {
                    "type": "integer",
                    "minimum": 0,
                    "exclusiveMinimum": true
                  }
                },
                "required": [
                  "fileId"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建分享",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Share"
                }
              }
            }
          }
        }
      }
    },
    "/api/schedules": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "maxLength": 2048,
                    "format": "uri"
                  },
                  "filename": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "cron": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "once",
                      "daily",
                      "weekly",
                      "monthly"
                    ]
                  }
                },
                "required": [
                  "url",
                  "cron",
                  "type"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建调度",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Schedule"
                }
              }
            }
          }
        }
      }
    }
  }
}