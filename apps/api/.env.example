# Download Manager Backend - Environment Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5001

# Security - MUST CHANGE IN PRODUCTION
JWT_SECRET=your-super-secret-jwt-key-here-at-least-32-characters

# Upload Configuration
UPLOAD_PATH=./uploads

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_db_username
MYSQL_PASSWORD=your_secure_db_password
MYSQL_DATABASE=download_manager

# Database Type (mysql or sqlite)
DB_TYPE=mysql

# Prisma Database URL (P3)
DATABASE_URL="mysql://username:password@localhost:3306/download_manager"

# Seed Account Passwords (only needed when running `prisma db seed`)
SEED_ADMIN_PASSWORD=your_seed_admin_password
SEED_USER_PASSWORD=your_seed_user_password

# AI Proxy Configuration (server-side only, never expose to frontend)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini