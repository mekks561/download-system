{
  "name": "desktop",
  "version": "3.2.0",
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "build": {
    "appId": "com.dm.download-manager",
    "productName": "DM Download Manager",
    "directories": {
      "output": "dist-final-v3-stable"
    },
    "files": [
      "out/**/*",
      "index.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/${platform}",
        "to": "mariadb-bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../apps/api/dist",
        "to": "api-dist"
      },
      {
        "from": "../../apps/web/build",
        "to": "renderer/web"
      },
      {
        "from": "../../apps/gm-admin/build",
        "to": "renderer/admin"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mekks561",
        "repo": "download-system"
      }
    ]
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-builder --publish never",
    "preview": "electron-vite preview",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dm/shared": "workspace:*",
    "electron-serve": "^3.0.1",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^22.0.0",
    "electron": "^32.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^6.0.3"
  }
}
