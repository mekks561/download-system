# =============================================================
# download-manager 环境变量模板
# =============================================================
# 用法：cp .env.example .env  然后按需填写
# ⚠️ .env 已被 .gitignore 忽略（第 51 行），**切勿**把真实密钥提交进版本库。
# ⚠️ docker-compose.yml 通过 ${VAR} 插值读取本文件，变量名不可随意改。
# =============================================================

# -------------------------------------------------------------
# 数据库（MariaDB）
# docker-compose.yml 的 db 服务用这四项初始化账号与库名；
# api 服务的 DATABASE_URL 也由它们拼出。
# -------------------------------------------------------------
DB_NAME=download_manager
DB_USER=dm
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# -------------------------------------------------------------
# 服务端口（对外映射；容器内固定 api=5001 / worker=5002 / web=80 / admin=80）
# 🔴 默认值 3005/3006/5001 在 NAS 上**已被占用**，改端口前先确认没撞车。
# -------------------------------------------------------------
API_PORT=5001
WORKER_PORT=5002
WEB_PORT=3005
ADMIN_PORT=3006

# -------------------------------------------------------------
# 集群安全 (Industrialization 2.0)
# INTERNAL_SECRET: Master 与 Worker 通讯的共享密钥，必须一致。
# REDIS_PASSWORD: Redis 服务的访问密码。
# -------------------------------------------------------------
INTERNAL_SECRET=replace-with-secure-internal-secret
REDIS_PASSWORD=change-me-redis

# -------------------------------------------------------------
# JWT 密钥
# 🔴 主站与 GM 后台必须使用**不同的**密钥：两者载荷结构相近，
#    共用密钥会导致主站令牌可直接当 GM 令牌用（越权）。
# 生成方式：openssl rand -hex 32
# -------------------------------------------------------------
JWT_SECRET=replace-with-32-bytes-random
GM_JWT_SECRET=replace-with-another-32-bytes-random

# -------------------------------------------------------------
# GM 初始管理员（仅 `pnpm db:seed:gm` 读取）
# 🔴 脚本对这两项做**严格校验**：缺失或为空会直接抛错退出。
# ⚠️ 该脚本用 upsert 写入：改完这两项重跑，会**覆盖现有 GM 口令**。
#    因此填入前请确认这就是你想要的口令；不打算改口令就留空。
# -------------------------------------------------------------
GM_ADMIN_USERNAME=gm-admin
GM_ADMIN_PASSWORD=

# -------------------------------------------------------------
# AI 能力（/api/ai，可选）
# 不填 API KEY 时该路由返回「未配置」，不影响其它功能。
# OPENAI_BASE_URL 可指向任意 OpenAI 兼容网关（如自建代理）。
# -------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# -------------------------------------------------------------
# 以下变量**不在本文件设置**，由 docker-compose.yml 在容器内注入：
#   NODE_ENV / PORT / DATABASE_URL / MYSQL_* / DB_TYPE
#   PLUGINS_DIR / UPLOAD_PATH / DM_DOWNLOAD_ROOT
# 本地直接跑 api 时若需要，可自行补一份 apps/api/.env。
# -------------------------------------------------------------
