# GM Admin Backend - Environment Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
GM_PORT=5002

# Security - MUST CHANGE IN PRODUCTION
GM_JWT_SECRET=your-gm-super-secret-key-here-at-least-32-characters
GM_JWT_EXPIRES_IN=8h

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_db_username
MYSQL_PASSWORD=your_secure_db_password
MYSQL_DATABASE=download_manager

# Default Admin User - MUST CHANGE IN PRODUCTION
GM_DEFAULT_USERNAME=admin
GM_DEFAULT_PASSWORD=Your_Secure_Password_123
GM_DEFAULT_EMAIL=admin@your-domain.com